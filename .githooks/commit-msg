#!/bin/sh
root=$(git rev-parse --show-toplevel) || exit 1
if command -v python >/dev/null 2>&1; then
    exec python "$root/scripts/check_commit_message.py" "$1"
fi
if command -v python3 >/dev/null 2>&1; then
    exec python3 "$root/scripts/check_commit_message.py" "$1"
fi
echo "Python is required to validate the commit message." >&2
exit 1
